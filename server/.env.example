# Copy to server/.env and adjust.

NODE_ENV=development
# Port for the API. Hosts such as Render set PORT instead - leave API_PORT out there.
API_PORT=3002

# Postgres connection string. Append ?sslmode=require for managed databases (Neon, Supabase, ...).
DATABASE_URL=postgres://localhost:5432/enagar

# 64 hex characters. Encrypts PAN numbers at rest. REQUIRED in production; keep a safe copy - data
# encrypted with a lost key cannot be recovered. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=

# Hours a login session stays valid.
SESSION_TTL_HOURS=12

# Number of reverse-proxy hops in front of the app (0 = none; 1 on Render).
TRUST_PROXY=0

# Web-app origin(s) allowed to call this API from a browser, comma-separated, no path or trailing slash.
# Needed when the web app is on GitHub Pages and the API elsewhere.
# CORS_ORIGINS=https://kdkapsikar.github.io

# Daily birthday / anniversary wishes are prepared at this hour (24h clock) in TZ_NAME.
TZ_NAME=Asia/Kolkata
REMINDER_HOUR=7

# manual = staff send each message from their own WhatsApp (wa.me link), log = print to console (dev).
MESSAGE_CHANNEL=manual

# Used only by `npm test` (the test suite TRUNCATES this database - never point it at real data).
# TEST_DATABASE_URL=postgres://localhost:5432/enagar_test
